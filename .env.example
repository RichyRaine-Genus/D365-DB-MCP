# D365 AxDB Connection — copy this file to .env and fill in YOUR machine details
# .env is gitignored and never committed.
#
# Each Tier 1 DEV machine has its own local SQL Server + AxDB instance.
# Find your machine name by running:  hostname
#
# ─────────────────────────────────────────────────────────────────────────────

# Your local Tier 1 DEV machine name (e.g. GNSPLC-DEV-123)
AXDB_SERVER=GNSPLC-DEV-###

# Database name — almost always AxDB, but may differ on some machines
AXDB_DATABASE=AxDB

# ODBC driver — must be installed on your machine
# Check installed drivers: Get-OdbcDriver -Name "ODBC Driver*" -Platform "64-bit"
# Install from: https://aka.ms/odbc17  (ODBC Driver 17 for SQL Server)
AXDB_DRIVER=ODBC Driver 17 for SQL Server
